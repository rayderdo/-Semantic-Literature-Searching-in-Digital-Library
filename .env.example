# Template of the project settings.
# Each person copies this file to a file named .env (same folder) and fills it in.
# (database/start_database.py does the copy automatically the first time.)
# .env is personal and is NEVER uploaded to GitHub (.gitignore blocks it).
# Read by: docker-compose.yml (POSTGRES_*) and the Python code (DATABASE_URL, keys).

# --- Database (Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=semantic_search
# Use 5433 if PostgreSQL is already installed on your computer (and change DATABASE_URL too).
POSTGRES_PORT=5432

# How code connects to the database (must match the 4 values above).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semantic_search

# --- OpenAlex (data download) ---
# Free key: https://openalex.org/signup then https://openalex.org/settings/api-key
OPENALEX_API_KEY=

# --- Embeddings (filled in when the team chooses the embedding model/API) ---
EMBEDDING_MODEL_NAME=
EMBEDDING_DIM=
